# ==============================================================================
# UrbanPulse AI Environment Configuration (Production & Local Development)
# ==============================================================================

# Backend Configuration (Render)
PORT=8000
LOG_LEVEL="INFO"
JWT_SECRET="your_secure_production_jwt_secret_key_2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS & Frontend Origins (Render Environment)
FRONTEND_URL="https://your-app-name.vercel.app"
CORS_ORIGINS=["https://your-app-name.vercel.app","http://localhost:5173"]

# Database (Optional - Defaults to SQLite /data/urbanpulse.db auto-seeded)
DATABASE_URL="sqlite:///./data/urbanpulse.db"

# Frontend Configuration (Vercel)
# Set VITE_API_BASE_URL to your Render backend HTTPS endpoint
VITE_API_BASE_URL="https://urbanpulse-backend.onrender.com"
